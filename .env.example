# Copy this file to .env and fill in real values. Never commit .env itself.

PORT=3000
JWT_SECRET=replace_with_a_long_random_string

# Turso database (same pattern as Atma Raksha AI)
TURSO_DB_URL=libsql://your-db-name.turso.io
TURSO_DB_AUTH_TOKEN=your_turso_auth_token

# Gemini API key (free tier) - used server-side so it's never exposed to the app
GEMINI_API_KEY=your_gemini_api_key

# Free automated backups AND scheduled recurring extraction (optional but recommended) -
# triggered by cron-job.org hitting POST /api/admin/backup or POST /api/admin/run-scheduled
# with header X-Backup-Secret: <BACKUP_SECRET>. Requires a free Brevo account for backup
# emails (same one used for Atma Raksha AI's emails) - not needed for run-scheduled alone.
BACKUP_SECRET=another_long_random_string
BACKUP_EMAIL=you@example.com
BREVO_API_KEY=your_brevo_api_key
